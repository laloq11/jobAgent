# Copy to .env (git-ignored) and fill in. Read by jobs_agent/core/config.py.
NOTION_TOKEN=
NOTION_DB_ID=

# Optional: Adzuna adapter (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: run_notify digest email. Gmail needs an app password.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=
NOTIFY_FROM=
